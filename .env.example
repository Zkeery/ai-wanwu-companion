# 本项目的业务配置模板；实际实现后补充变量名，不能填写真实密钥。
# 复制为 .env 后再填写。不得从其他业务项目复制配置。

# R4：真实契约与质量验收后再开放
SCENE_AGENT_ENABLED=false
GENERATION_QUOTA_ENABLED=false

# C1.47：参考图动作候选，仅显式维护命令读取；默认不联网
MOTION_ATLAS_BASE_URL=
MOTION_ATLAS_API_KEY=

# C1.54：Sunburst单次散步候选，仅显式执行维护命令时读取
OPENAI_API_KEY=

# C1.55：AIHubMix独立凭证；不得填写OpenAI或其他项目的Key
AIHUBMIX_API_KEY=
# 共同空间真实交流默认关闭；开启后仍需独立单次费用授权。
GATHERING_DIALOGUE_ENABLED=false
GATHERING_DIALOGUE_AUTOMATIC_ENABLED=false
