# 模型配置（开发期可留空，用 mock 推进；验收前填真实 Key）
MODEL_BASE_URL=https://maas-api.antdigital.com/v1
IMAGE_BASE_URL=https://maas-api.antdigital.com/v1
MODEL_API_KEY=
QWEN_TTS_API_KEY=
VISION_MODEL=ling-3.0-flash-vl
IMAGE_MODEL=wan2.6-t2i
CHAT_MODEL=qwen3.8-flash
# 候选提速参数；仅 qwen3.8-flash，真实验收通过后才考虑启用。
# 不设置时保持服务商默认模式。不要把下行直接用于生产验收结论。
# MODEL_ENABLE_THINKING=false
# R7.3: verified parameter dialect only for MaaS ling-3.0-flash-vl.
# Optional; omitting preserves provider defaults. Not a <=5s guarantee.
# VISION_ENABLE_THINKING=false
# Reuse bounded model POST connections; downloads remain isolated.
MODEL_HTTP_POOL_ENABLED=false

# 数据与上传
DATABASE_URL=sqlite:///./data/app.db
UPLOAD_DIR=./data/uploads

# 模型调用护栏
MODEL_TIMEOUT_SECONDS=120
MODEL_MAX_RETRIES=2
# One validated response supplies name/persona/opening; false restores split mode.
CHARACTER_BUNDLE_ENABLED=true
# Recognition copy only; original accepted input <=4096px, generated avatar stays 1024px.
VISION_MAX_EDGE=2048

# 账号与会话（R2）
SESSION_TTL_SECONDS=2592000
CODE_TTL_SECONDS=300
CODE_RESEND_SECONDS=60
CODE_DAILY_LIMIT=10
CODE_MAX_ATTEMPTS=5
# 仅本地开发过渡：固定令牌映射到一个本地开发账号，供前端联调前预览；正式环境留空禁用。
DEV_AUTH_TOKEN=
# 仅本地开发过渡：固定验证码（登录联调用）；正式环境必须留空禁用。
DEV_SMS_FIXED_CODE=

# Real SMS remains disabled until service/template and a concrete send budget are approved.
# Install signing dependency: .venv/bin/python -m pip install -r requirements-sms.txt
SMS_PROVIDER=mock
SMS_LIVE_ENABLED=false
SMS_ACCESS_KEY_ID=
SMS_SECRET_ACCESS_KEY=
SMS_ACCOUNT=
SMS_SIGN=
SMS_TEMPLATE_ID=
SMS_DAILY_LIMIT=0
SMS_TIMEOUT_SECONDS=10

# Real life runtime; does not allocate budget or grant user permission.
# Requires the validated planner and persistent SQLite; cannot mix with previews.
LIFE_RUNTIME_ENABLED=false
GATHERING_DIALOGUE_AUTOMATIC_ENABLED=false
GATHERING_DIALOGUE_ENABLED=false

# R4：真实契约与质量验收后再开放
SCENE_AGENT_ENABLED=false
GENERATION_QUOTA_ENABLED=false

# R6.2: production refuses all development shortcuts and mock SMS.
APP_ENV=development
# Local migration only: explicit user ID, blank disables /auth/claim.
LEGACY_CLAIM_USER_ID=
