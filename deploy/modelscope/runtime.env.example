# Non-secret runtime settings for the confirmed existing provider.
# MODEL_API_KEY must be added separately as a ModelScope encrypted variable.
MODEL_BASE_URL=https://maas-api.antdigital.com/v1
IMAGE_BASE_URL=https://maas-api.antdigital.com/v1
VISION_MODEL=ling-3.0-flash-vl
IMAGE_MODEL=wan2.6-t2i
CHAT_MODEL=qwen3.8-flash
VISION_ENABLE_THINKING=false
MODEL_TIMEOUT_SECONDS=60
MODEL_MAX_RETRIES=0
# Normal user operation is independent from the archived 2026-10-02 acceptance batch.
CLOUD_SERVICE_MODE=normal
# Docker already sets production + invite + persistent paths + real life runtime.
# No budget or invitation is created automatically; operator grants are separate.
