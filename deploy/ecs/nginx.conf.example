# Replace domain, certificate paths and log policy on the approved ECS.
# This template does not obtain a certificate or expose a local test service.
server {
    listen 80;
    server_name companion.example.invalid;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    server_name companion.example.invalid;
    ssl_certificate /etc/ai-companion/tls/fullchain.pem;
    ssl_certificate_key /etc/ai-companion/tls/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 12m;
    # Avoid recording query strings, user paths, phone numbers or tokens.
    access_log off;
    error_log /var/log/nginx/ai-companion-error.log crit;

    location / {
        proxy_pass http://127.0.0.1:3020;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_cache off;
        proxy_connect_timeout 10s;
        proxy_read_timeout 180s;
        proxy_send_timeout 180s;
    }
}
